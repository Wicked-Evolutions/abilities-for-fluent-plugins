{
  "name": "wicked-evolutions/abilities-for-fluent-plugins",
  "description": "WordPress Abilities API integration for the Fluent plugin ecosystem",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "autoload": {
    "psr-4": {
      "WickedEvolutions\\AbilitiesForFluent\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "require-dev": {
    "nikic/php-parser": "^4.19 || ^5.0",
    "opis/json-schema": "^2.3",
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test:contract": "phpunit --testsuite Contract",
    "test": "phpunit"
  }
}
